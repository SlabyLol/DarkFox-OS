#!/bin/bash
# Creates a "persistence" partition in the free space of the USB stick
# DarkFox was booted from, so files and settings are kept between boots.
set -euo pipefail
exec > >(tee /tmp/darkfox-persistence.log) 2>&1

if [ "$(id -u)" -ne 0 ]; then
    echo "Must run as root"; exit 1
fi

if blkid -L persistence >/dev/null 2>&1; then
    echo "A partition labelled 'persistence' already exists."; exit 0
fi

SRC=$(findmnt -n -o SOURCE /run/live/medium 2>/dev/null || true)
[ -n "$SRC" ] || { echo "Boot medium not found (/run/live/medium)."; exit 1; }

PK=$(lsblk -no PKNAME "$SRC" 2>/dev/null | head -n1 || true)
if [ -n "$PK" ]; then DISK="/dev/$PK"; else DISK="$SRC"; fi
[ -b "$DISK" ] || { echo "Disk $DISK not found."; exit 1; }
echo "Boot disk: $DISK"

BEFORE=$(lsblk -lnpo NAME "$DISK" | sort)

# new partition in all the free space after the existing ones
echo ',,L' | sfdisk --append --no-reread "$DISK"
partprobe "$DISK" || true
udevadm settle || true
sleep 2

NEW=$(comm -13 <(echo "$BEFORE") <(lsblk -lnpo NAME "$DISK" | sort) | head -n1)
[ -b "$NEW" ] || { echo "New partition not found."; exit 1; }
echo "New partition: $NEW"

mkfs.ext4 -F -L persistence "$NEW"

MNT=$(mktemp -d)
mount "$NEW" "$MNT"
echo "/ union" > "$MNT/persistence.conf"
sync
umount "$MNT"
rmdir "$MNT"

echo "Done."
