#!/bin/bash
# DarkFox OS first-time setup:
#  1. create storage on the USB stick (persistence)  -> reboot
#  2. choose a password for the user
MARK="$HOME/.config/darkfox-setup-done"
[ -e "$MARK" ] && exit 0
sleep 3

persistence_active() {
    ls -d /run/live/persistence/* >/dev/null 2>&1
}

if ! persistence_active; then
    zenity --question --title="DarkFox OS Einrichtung" --width=420 \
        --ok-label="Jetzt einrichten" --cancel-label="Später" \
        --text="Willkommen bei DarkFox OS!\n\nDamit deine Dateien und Einstellungen auf dem USB-Stick gespeichert bleiben, wird einmalig Speicherplatz auf dem Stick angelegt.\n\nDer Laptop startet danach neu.\nAchtung: Den Stick dabei nicht abziehen." \
        || exit 0

    if sudo /usr/local/bin/darkfox-create-persistence | zenity --progress --pulsate --auto-close \
            --no-cancel --title="DarkFox OS" --text="Speicher auf dem Stick wird angelegt..."; then
        :
    fi

    if blkid -L persistence >/dev/null 2>&1; then
        zenity --info --title="DarkFox OS" --width=380 \
            --text="Fertig! Der Laptop startet jetzt neu.\nStick bitte stecken lassen." 
        sudo systemctl reboot
    else
        zenity --error --title="DarkFox OS" --width=420 \
            --text="Der Speicher konnte nicht angelegt werden.\n\n$(tail -n 8 /tmp/darkfox-persistence.log 2>/dev/null)"
    fi
    exit 0
fi

# persistence is active: let the user choose a password
while true; do
    OUT=$(zenity --forms --title="DarkFox OS Einrichtung" --width=420 \
        --text="Wähle ein Passwort für den Benutzer 'darkfox'." \
        --add-password="Neues Passwort" --add-password="Passwort wiederholen" \
        --separator=$'\n') || exit 0
    PW1=$(echo "$OUT" | sed -n 1p)
    PW2=$(echo "$OUT" | sed -n 2p)
    if [ "${#PW1}" -lt 4 ]; then
        zenity --error --text="Das Passwort muss mindestens 4 Zeichen haben."
    elif [ "$PW1" != "$PW2" ]; then
        zenity --error --text="Die Passwörter sind nicht gleich."
    else
        break
    fi
done

echo "$USER:$PW1" | sudo chpasswd
mkdir -p "$HOME/.config"
touch "$MARK"
zenity --info --title="DarkFox OS" --text="Einrichtung abgeschlossen.\nDeine Dateien bleiben jetzt auf dem Stick."
