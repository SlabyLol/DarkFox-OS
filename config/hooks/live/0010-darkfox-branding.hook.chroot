#!/bin/sh
set -e
export DEBIAN_FRONTEND=noninteractive

echo "=== DarkFox OS Branding ==="
echo "darkfox" > /etc/hostname

XF=/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml
mkdir -p "$XF" /etc/skel/.config/xfce4/terminal /etc/skel/.config/autostart \
         /usr/share/backgrounds /usr/share/plymouth/themes/darkfox

# ------------------------------------------------------------------
# 1. Images (generated here, so no binary files are needed in the repo)
# ------------------------------------------------------------------
F=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
P=/usr/share/plymouth/themes/darkfox
convert -background none -font "$F" -pointsize 110 \
    -fill '#e8eefc' label:"Dark" -fill '#ff7a1a' label:"Fox" -fill '#e8eefc' label:" OS" \
    +append +repage "$P/logo.png" || echo "logo failed"
convert -size 8x6 xc:'#ff7a1a' "$P/fill.png" || true
convert -size 8x6 xc:'#2a3358' "$P/track.png" || true
convert -size 1920x1080 gradient:'#0b0f1a-#1b2340' \
    \( -background none -font "$F" -pointsize 260 -fill 'rgba(255,255,255,0.06)' label:"DarkFox" \) \
    -gravity center -compose over -composite /usr/share/backgrounds/darkfox.png || echo "wallpaper failed"

# ------------------------------------------------------------------
# 2. Boot splash (Plymouth)
# ------------------------------------------------------------------
cat > "$P/darkfox.plymouth" << 'EOF'
[Plymouth Theme]
Name=DarkFox
Description=DarkFox OS boot splash
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/darkfox
ScriptFile=/usr/share/plymouth/themes/darkfox/darkfox.script
EOF

cat > "$P/darkfox.script" << 'EOF'
Window.SetBackgroundTopColor(0.043, 0.059, 0.102);
Window.SetBackgroundBottomColor(0.106, 0.145, 0.251);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 40);
logo.sprite.SetZ(10);

bar_w = Window.GetWidth() / 4;
bar_h = 6;
bar_x = Window.GetWidth() / 2 - bar_w / 2;
bar_y = Window.GetHeight() / 2 + logo.image.GetHeight() / 2 + 20;

track.image = Image("track.png").Scale(bar_w, bar_h);
track.sprite = Sprite(track.image);
track.sprite.SetPosition(bar_x, bar_y, 10);

fill.src = Image("fill.png");
fill.sprite = Sprite(fill.src.Scale(8, bar_h));
fill.sprite.SetPosition(bar_x, bar_y, 11);

fun progress_callback(duration, progress) {
    w = Math.Int(bar_w * progress);
    if (w < 8) w = 8;
    fill.sprite.SetImage(fill.src.Scale(w, bar_h));
}
Plymouth.SetBootProgressFunction(progress_callback);

counter = 0;
fun refresh_callback() {
    counter = counter + 1;
    logo.sprite.SetOpacity(0.7 + 0.3 * Math.Sin(counter / 15));
}
Plymouth.SetRefreshFunction(refresh_callback);
EOF

plymouth-set-default-theme darkfox || echo "plymouth theme not set"

# ------------------------------------------------------------------
# 3. Login screen + autologin
# ------------------------------------------------------------------
mkdir -p /etc/lightdm/lightdm.conf.d
cat > /etc/lightdm/lightdm.conf.d/50-darkfox-autologin.conf << 'EOF'
[Seat:*]
autologin-user=darkfox
autologin-user-timeout=0
autologin-session=xfce
EOF

cat > /etc/lightdm/lightdm-gtk-greeter.conf << 'EOF'
[greeter]
background=/usr/share/backgrounds/darkfox.png
theme-name=Arc-Dark
icon-theme-name=Papirus-Dark
font-name=Noto Sans 11
EOF

# ------------------------------------------------------------------
# 4. XFCE defaults (copied into the home of the user created below)
# ------------------------------------------------------------------
cat > "$XF/xsettings.xml" << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="ThemeName" type="string" value="Arc-Dark"/>
    <property name="IconThemeName" type="string" value="Papirus-Dark"/>
    <property name="EnableEventSounds" type="bool" value="true"/>
    <property name="EnableInputFeedbackSounds" type="bool" value="true"/>
    <property name="SoundThemeName" type="string" value="freedesktop"/>
  </property>
  <property name="Gtk" type="empty">
    <property name="FontName" type="string" value="Noto Sans 10"/>
    <property name="MonospaceFontName" type="string" value="Fira Code 11"/>
  </property>
</channel>
EOF

cat > "$XF/xfwm4.xml" << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="theme" type="string" value="Arc-Dark"/>
  </property>
</channel>
EOF

{
echo '<?xml version="1.0" encoding="UTF-8"?>'
echo '<channel name="xfce4-desktop" version="1.0">'
echo '  <property name="backdrop" type="empty">'
echo '    <property name="screen0" type="empty">'
for m in monitor0 monitoreDP-1 monitorLVDS-1 monitorVGA-1 monitorHDMI-1; do
    echo "      <property name=\"$m\" type=\"empty\">"
    echo '        <property name="workspace0" type="empty">'
    echo '          <property name="color-style" type="int" value="0"/>'
    echo '          <property name="image-style" type="int" value="5"/>'
    echo '          <property name="last-image" type="string" value="/usr/share/backgrounds/darkfox.png"/>'
    echo '        </property>'
    echo '      </property>'
done
echo '    </property>'
echo '  </property>'
echo '</channel>'
} > "$XF/xfce4-desktop.xml"

cat > /etc/skel/.config/xfce4/terminal/terminalrc << 'EOF'
[Configuration]
FontName=Fira Code 11
MiscAlwaysShowTabs=FALSE
ScrollingBar=TERMINAL_SCROLLBAR_NONE
ColorForeground=#e8eefc
ColorBackground=#0b0f1a
ColorCursor=#ff7a1a
ColorPalette=#1b2340;#ff5c57;#5af78e;#f3f99d;#57c7ff;#ff6ac1;#9aedfe;#e8eefc;#686868;#ff5c57;#5af78e;#f3f99d;#57c7ff;#ff6ac1;#9aedfe;#ffffff
BackgroundMode=TERMINAL_BACKGROUND_TRANSPARENT
BackgroundDarkness=0.95
EOF

# startup sound + unmute (autostart for every user)
cat > /etc/xdg/autostart/darkfox-startup-sound.desktop << 'EOF'
[Desktop Entry]
Type=Application
Name=DarkFox Startup Sound
Exec=sh -c "amixer -q sset Master unmute 2>/dev/null; amixer -q sset Master 70%% 2>/dev/null; paplay /usr/share/sounds/freedesktop/stereo/desktop-login.oga || paplay /usr/share/sounds/freedesktop/stereo/service-login.oga"
Terminal=false
X-GNOME-Autostart-Delay=2
EOF

# comfortable shell for programming
cat >> /etc/skel/.bashrc << 'EOF'

# ---- DarkFox ----
export EDITOR=nano
alias ll='ls -lah --color=auto'
alias gs='git status'
alias gl='git log --oneline --graph --decorate -20'
alias fd='fdfind'
[ -f /usr/lib/git-core/git-sh-prompt ] && . /usr/lib/git-core/git-sh-prompt
PS1='\[\e[38;5;208m\]\u@darkfox\[\e[0m\] \[\e[36m\]\w\[\e[0m\]$(__git_ps1 " (%s)")\n\$ '
EOF

git config --system init.defaultBranch main || true

# ------------------------------------------------------------------
# 5. Live user (created at build time, login does not depend on live-config)
# ------------------------------------------------------------------
if ! id darkfox >/dev/null 2>&1; then
    useradd -m -s /bin/bash darkfox
fi
for g in sudo audio video cdrom plugdev netdev dip lpadmin scanner bluetooth fuse; do
    if getent group "$g" >/dev/null 2>&1; then usermod -aG "$g" darkfox; fi
done
echo "darkfox:live" | chpasswd
echo "root:live" | chpasswd     # emergency: Ctrl+Alt+F2

# NOTE: sudo uses the LAST matching rule and reads files alphabetically,
# so the NOPASSWD rule must come last -> file name starts with "zz".
echo "%sudo ALL=(ALL:ALL) ALL" > /etc/sudoers.d/sudo
echo "darkfox ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/zz-darkfox-nopasswd
chmod 440 /etc/sudoers.d/sudo /etc/sudoers.d/zz-darkfox-nopasswd
rm -f /etc/sudoers.d/darkfox

# ------------------------------------------------------------------
# 6a. Broadcom WiFi (MacBooks etc.): proprietary "wl" driver via DKMS,
#     b43 firmware as fallback. Build continues if this fails.
# ------------------------------------------------------------------
apt-get update || true
KVER=$(ls /lib/modules | sort -V | tail -n1)
echo "Kernel in chroot: $KVER"
mkdir -p /tmp/fakebin
cat > /tmp/fakebin/uname << EOF
#!/bin/sh
if [ "\$1" = "-r" ]; then echo "$KVER"; else exec /bin/uname "\$@"; fi
EOF
chmod +x /tmp/fakebin/uname
(
    export PATH=/tmp/fakebin:$PATH
    apt-get install -y --no-install-recommends dkms linux-headers-amd64 &&
    apt-get install -y --no-install-recommends broadcom-sta-dkms &&
    dkms autoinstall -k "$KVER"
) || echo "wl driver step had errors"
if ! modinfo -k "$KVER" wl >/dev/null 2>&1; then
    echo "wl module missing -> trying b43 firmware installer"
    apt-get install -y --no-install-recommends firmware-b43-installer || echo "b43 installer failed"
fi
depmod -a "$KVER" || true
rm -rf /tmp/fakebin

# MacBook fan control (harmless on other laptops)
apt-get install -y --no-install-recommends mbpfan || echo "mbpfan skipped"

# touchpad: tap to click
mkdir -p /etc/X11/xorg.conf.d
cat > /etc/X11/xorg.conf.d/40-darkfox-touchpad.conf << 'EOF'
Section "InputClass"
    Identifier "DarkFox touchpad"
    MatchIsTouchpad "on"
    Driver "libinput"
    Option "Tapping" "on"
    Option "NaturalScrolling" "false"
EndSection
EOF

# ------------------------------------------------------------------
# 6. VS Code (official Microsoft package; build continues if download fails)
# ------------------------------------------------------------------
(
    echo "code code/add-microsoft-repo boolean false" | debconf-set-selections
    curl -fL --retry 3 -o /tmp/code.deb "https://update.code.visualstudio.com/latest/linux-deb-x64/stable" &&
    apt-get install -y --no-install-recommends /tmp/code.deb &&
    rm -f /tmp/code.deb /etc/apt/sources.list.d/vscode.* /etc/apt/trusted.gpg.d/microsoft.*
) || echo "VS Code install skipped"

# ------------------------------------------------------------------
# 7. Helper scripts
# ------------------------------------------------------------------
cat > /usr/local/bin/darkfox-create-persistence << 'EOF'
#!/bin/bash
# Creates a "persistence" partition in the free space of the USB stick
# DarkFox was booted from, so files and settings are kept between boots.
LOG=/tmp/darkfox-persistence.log
exec > >(tee "$LOG") 2>&1
fail() { echo "FEHLER: $*"; exit 1; }

echo "== DarkFox persistence setup: $(date) =="
[ "$(id -u)" -eq 0 ] || fail "root needed"
echo "Kernel cmdline: $(cat /proc/cmdline)"

if blkid -L persistence >/dev/null 2>&1; then
    echo "persistence partition already exists: $(blkid -L persistence)"
    exit 0
fi

SRC=$(findmnt -n -o SOURCE /run/live/medium 2>/dev/null)
[ -n "$SRC" ] || SRC=$(blkid -L DarkFox_OS 2>/dev/null)
[ -n "$SRC" ] || fail "Boot-Medium nicht gefunden"
echo "Boot medium: $SRC"

PK=$(lsblk -no PKNAME "$SRC" 2>/dev/null | head -n1)
if [ -n "$PK" ]; then DISK="/dev/$PK"; else DISK="$SRC"; fi
[ -b "$DISK" ] || fail "Datentraeger $DISK nicht gefunden"
PTT=$(blkid -p -s PTTYPE -o value "$DISK" 2>/dev/null)
echo "Boot disk: $DISK   partition table: ${PTT:-none}"
lsblk -f "$DISK"
sfdisk -l "$DISK" 2>&1 || true
sfdisk -F "$DISK" 2>&1 || true

BEFORE=$(lsblk -lnpo NAME "$DISK" | sort)

case "$PTT" in
    gpt)
        sgdisk -e "$DISK" || fail "sgdisk -e fehlgeschlagen"
        sgdisk -n 0:0:0 -t 0:8300 -c 0:persistence "$DISK" || fail "sgdisk: kein freier Platz auf dem Stick?"
        ;;
    *)
        echo ',,L' | sfdisk --append --no-reread "$DISK" || fail "sfdisk: kein freier Platz auf dem Stick?"
        ;;
esac

NEW=""
for try in 1 2 3 4 5; do
    partprobe "$DISK" 2>/dev/null || true
    partx -a "$DISK" 2>/dev/null || true
    udevadm settle 2>/dev/null || true
    sleep 2
    NEW=$(comm -13 <(echo "$BEFORE") <(lsblk -lnpo NAME "$DISK" | sort) | head -n1)
    [ -b "$NEW" ] && break
done
[ -b "$NEW" ] || fail "neue Partition wurde vom Kernel nicht erkannt"
echo "Neue Partition: $NEW"

# safety: never format something that already has a filesystem or is mounted
[ -z "$(blkid -p -s TYPE -o value "$NEW" 2>/dev/null)" ] || fail "$NEW hat schon ein Dateisystem - abgebrochen"
findmnt -n "$NEW" >/dev/null 2>&1 && fail "$NEW ist eingehaengt - abgebrochen"

mkfs.ext4 -F -L persistence "$NEW" || fail "mkfs.ext4 fehlgeschlagen"

MNT=$(mktemp -d)
mount "$NEW" "$MNT" || fail "mount fehlgeschlagen"
echo "/ union" > "$MNT/persistence.conf"
sync
umount "$MNT"
rmdir "$MNT"
echo "Fertig. Label: $(blkid -s LABEL -o value "$NEW")"
EOF

cat > /usr/local/bin/darkfox-setup << 'EOF'
#!/bin/bash
# DarkFox OS setup.   darkfox-setup          -> first-time setup (storage + password)
#                     darkfox-setup storage  -> only the storage step (menu entry)
MODE="${1:-all}"
MARK="$HOME/.config/darkfox-setup-done"
if [ "$MODE" != "storage" ]; then
    [ -e "$MARK" ] && exit 0
    sleep 4
fi

persistence_active() { ls -d /run/live/persistence/* >/dev/null 2>&1; }

setup_storage() {
    if blkid -L persistence >/dev/null 2>&1; then
        zenity --error --title="DarkFox OS" --width=480 \
            --text="Der Speicher auf dem Stick existiert schon, ist aber nicht aktiv.\n\nStarte den Laptop einmal ganz neu (Stick stecken lassen).\nWenn es danach immer noch nicht geht, öffnet sich gleich die Diagnose.\nKlicke dort auf \"Auf USB-Stick kopieren\" und schicke mir die Datei."
        /usr/local/bin/darkfox-diagnose &
        return
    fi

    zenity --question --title="DarkFox OS Einrichtung" --width=440 \
        --ok-label="Jetzt einrichten" --cancel-label="Später" \
        --text="Willkommen bei DarkFox OS!\n\nDamit deine Dateien und Einstellungen auf dem USB-Stick gespeichert bleiben, wird einmalig Speicherplatz auf dem Stick angelegt.\n\nDer Laptop startet danach neu.\nDen Stick dabei bitte nicht abziehen." \
        || return

    zenity --info --no-wrap --title="DarkFox OS" \
        --text="Speicher wird angelegt, bitte warten ...\nStick nicht abziehen!" &
    DLG=$!
    sudo -n /usr/local/bin/darkfox-create-persistence >/dev/null 2>&1
    kill "$DLG" 2>/dev/null
    cp /tmp/darkfox-persistence.log "$HOME/darkfox-persistence.log" 2>/dev/null

    if blkid -L persistence >/dev/null 2>&1; then
        zenity --info --title="DarkFox OS" --width=380 \
            --text="Fertig! Der Laptop startet jetzt neu.\nStick bitte stecken lassen."
        sudo -n systemctl reboot
    else
        zenity --error --title="DarkFox OS" --width=520 \
            --text="Der Speicher konnte nicht angelegt werden.\n\n$(tail -n 6 /tmp/darkfox-persistence.log 2>/dev/null)\n\nGleich öffnet sich die Diagnose. Klicke dort auf \"Auf USB-Stick kopieren\"."
        /usr/local/bin/darkfox-diagnose &
    fi
}

if ! persistence_active; then
    setup_storage
    exit 0
fi

if [ "$MODE" = "storage" ]; then
    zenity --info --title="DarkFox OS" --width=420 \
        --text="Der Speicher auf dem Stick ist aktiv.\nDeine Dateien und Einstellungen bleiben erhalten."
    exit 0
fi

# storage is active: let the user choose a password
while true; do
    OUT=$(zenity --forms --title="DarkFox OS Einrichtung" --width=440 \
        --text="Wähle ein Passwort für den Benutzer 'darkfox'." \
        --add-password="Neues Passwort" --add-password="Passwort wiederholen" \
        --separator=$'\n') || exit 0
    PW1=$(echo "$OUT" | sed -n 1p)
    PW2=$(echo "$OUT" | sed -n 2p)
    if [ "${#PW1}" -lt 4 ]; then
        zenity --error --text="Das Passwort muss mindestens 4 Zeichen haben."
    elif [ "$PW1" != "$PW2" ]; then
        zenity --error --text="Die Passwörter sind nicht gleich."
    else
        break
    fi
done

echo "$USER:$PW1" | sudo -n chpasswd
mkdir -p "$HOME/.config"
touch "$MARK"
zenity --info --title="DarkFox OS" --text="Einrichtung abgeschlossen.\nDeine Dateien bleiben jetzt auf dem Stick."
EOF

cat > /usr/local/bin/darkfox-diagnose << 'EOF'
#!/bin/bash
# Diagnose: collects network + storage information, saves it as a log file
# and lets you copy that file to a USB stick (to send it for help).
export PATH="$PATH:/usr/sbin:/sbin"
LOG="$HOME/darkfox-diagnose.log"
SRC=$(findmnt -n -o SOURCE /run/live/medium 2>/dev/null)
PK=$(lsblk -no PKNAME "$SRC" 2>/dev/null | head -n1)
if [ -n "$PK" ]; then BOOTDISK="/dev/$PK"; else BOOTDISK="$SRC"; fi

{
    echo "DarkFox Diagnose - $(date)"
    echo "Kernel: $(uname -r)"
    echo; echo "############ SPEICHER ############"
    echo "== Kernel-Optionen =="; cat /proc/cmdline
    echo; echo "== Laufwerke =="; lsblk -f
    echo; echo "== Boot-Medium =="; findmnt /run/live/medium
    echo; echo "== Partition mit Label persistence =="; blkid -L persistence || echo "KEINE"
    echo; echo "== Aktiver Speicher =="; ls -la /run/live/persistence/ 2>&1
    cat /run/live/persistence/*/persistence.conf 2>&1
    echo; echo "== Root-Dateisystem =="; findmnt /; df -h / /home
    echo; echo "== Partitionstabelle Boot-Stick =="
    [ -n "$BOOTDISK" ] && sudo -n sfdisk -l "$BOOTDISK" 2>&1
    echo; echo "== Log der Speicher-Einrichtung =="; cat /tmp/darkfox-persistence.log 2>&1
    echo
    echo "############ NETZWERK ############"
    echo "== Geraete (nmcli) =="; nmcli device status
    echo; echo "== IP-Adressen =="; ip -br addr
    echo; echo "== WLAN-Netze =="; nmcli -f SSID,SIGNAL,SECURITY device wifi list 2>&1 | head -n 12
    echo; echo "== rfkill =="; rfkill list
    echo; echo "== Netzwerkkarten (PCI) =="; lspci -nnk | grep -iA3 -E 'network|ethernet'
    echo; echo "== USB =="; lsusb
    echo; echo "== Geladene WLAN-Module =="; lsmod | grep -E '^(wl|b43|bcma|ssb|brcm|iwl|ath|rtl)' || echo 'keine'
    echo; echo "== DKMS =="; dkms status 2>&1
    echo; echo "== Modul wl vorhanden? =="; modinfo wl 2>&1 | head -n 5
    echo; echo "== Treiber/Firmware-Meldungen (dmesg) =="
    sudo -n dmesg 2>&1 | grep -iE 'firmware|iwlwifi|ath[0-9k]|rtl|brcm|b43|bcma|wlan|wl:' | tail -n 30
    echo; echo "== NetworkManager Log =="; sudo -n journalctl -u NetworkManager -b --no-pager 2>&1 | tail -n 25
    echo; echo "== Dienste =="; systemctl is-active NetworkManager wpa_supplicant
} > "$LOG" 2>&1

DESK=$(xdg-user-dir DESKTOP 2>/dev/null)
[ -d "$DESK" ] && cp "$LOG" "$DESK/" 2>/dev/null

copy_to_usb() {
    local n=0 d
    for d in /media/"$USER"/*/ /media/*/; do
        [ -d "$d" ] && [ -w "$d" ] || continue
        if cp "$LOG" "$d" 2>/dev/null; then
            sync
            n=$((n+1))
            zenity --info --width=420 --title="DarkFox Diagnose" \
                --text="Log kopiert nach:\n$d\n\nDu kannst den Stick jetzt sicher entfernen (vorher in Thunar auswerfen)."
        fi
    done
    if [ "$n" -eq 0 ]; then
        zenity --warning --width=440 --title="DarkFox Diagnose" \
            --text="Kein beschreibbarer USB-Stick gefunden.\n\nStecke einen zweiten Stick (FAT32) ein, warte kurz und klicke dann noch einmal auf \"Auf USB-Stick kopieren\".\n\nDas Log liegt außerdem in deinem Home-Ordner:\n$LOG"
    fi
}

while true; do
    CHOICE=$(zenity --text-info --filename="$LOG" --width=780 --height=540 \
        --title="DarkFox Diagnose (gespeichert: $LOG)" \
        --ok-label="Schließen" \
        --extra-button="Auf USB-Stick kopieren" --extra-button="Ordner öffnen")
    case "$CHOICE" in
        "Auf USB-Stick kopieren") copy_to_usb ;;
        "Ordner öffnen") thunar "$HOME" >/dev/null 2>&1 & ;;
        *) break ;;
    esac
done
EOF

cat > /usr/share/applications/darkfox-diagnose.desktop << 'EOF'
[Desktop Entry]
Type=Application
Name=DarkFox Diagnose (Netzwerk und Speicher)
Comment=Zeigt, warum Internet oder Speichern nicht geht
Exec=/usr/local/bin/darkfox-diagnose
Icon=utilities-system-monitor
Categories=System;
Terminal=false
EOF

cat > /usr/share/applications/darkfox-storage.desktop << 'EOF'
[Desktop Entry]
Type=Application
Name=DarkFox Speicher einrichten
Comment=Dateien und Einstellungen auf dem USB-Stick speichern
Exec=/usr/local/bin/darkfox-setup storage
Icon=drive-removable-media
Categories=System;
Terminal=false
EOF

cat > /etc/xdg/autostart/darkfox-setup.desktop << 'EOF'
[Desktop Entry]
Type=Application
Name=DarkFox Setup
Exec=/usr/local/bin/darkfox-setup
Terminal=false
X-GNOME-Autostart-Delay=3
EOF

cat > /etc/systemd/system/darkfox-password.service << 'EOF'
[Unit]
Description=Set default DarkFox user password (until first-time setup is done)
After=live-config.service
Before=display-manager.service
ConditionPathExists=!/home/darkfox/.config/darkfox-setup-done

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'echo darkfox:live | chpasswd || true'

[Install]
WantedBy=multi-user.target
EOF

cat > /usr/share/applications/darkfox-doom.desktop << 'EOF'
[Desktop Entry]
Type=Application
Name=Doom (Freedoom)
Comment=Doom engine with the free Freedoom levels
Exec=chocolate-doom -iwad /usr/share/games/doom/freedoom1.wad
Icon=chocolate-doom
Categories=Game;ActionGame;
Terminal=false
EOF

chmod +x /usr/local/bin/darkfox-create-persistence /usr/local/bin/darkfox-setup /usr/local/bin/darkfox-diagnose /usr/local/bin/darkfox-store
systemctl enable darkfox-password.service 2>/dev/null || \
    ln -sf /etc/systemd/system/darkfox-password.service \
        /etc/systemd/system/multi-user.target.wants/darkfox-password.service
systemctl enable NetworkManager 2>/dev/null || true

# ------------------------------------------------------------------
# 7b. DarkFox OS Store (Debian packages + Flathub) and package settings
# ------------------------------------------------------------------
# install recommended packages too when installing software later
cat > /etc/apt/apt.conf.d/99darkfox << 'EOF'
APT::Install-Recommends "true";
APT::Install-Suggests "false";
EOF

# Flathub (build continues if there is no network)
flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo \
    || echo "flathub remote skipped (will be added when the store starts)"

# password dialog for the store / installer
cat > /etc/xdg/autostart/darkfox-polkit.desktop << 'EOF'
[Desktop Entry]
Type=Application
Name=DarkFox Polkit Agent
Exec=/usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1
Terminal=false
NoDisplay=true
EOF

cat > /usr/local/bin/darkfox-store << 'EOF'
#!/bin/bash
# DarkFox OS Store: Debian packages (apt) + Flathub (Flatpak) in GNOME Software
if command -v flatpak >/dev/null 2>&1 && ! flatpak remotes --system 2>/dev/null | grep -q flathub; then
    sudo -n flatpak remote-add --system --if-not-exists flathub \
        https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null
fi
exec gnome-software "$@"
EOF

cat > /usr/share/applications/darkfox-store.desktop << 'EOF'
[Desktop Entry]
Type=Application
Name=DarkFox OS Store
Comment=Programme aus Debian und Flathub installieren
Exec=/usr/local/bin/darkfox-store
Icon=org.gnome.Software
Categories=System;PackageManager;
Terminal=false
EOF

# ------------------------------------------------------------------
# 8. Rebuild initramfs so the boot splash is included
# ------------------------------------------------------------------
update-initramfs -u -k all || echo "initramfs update failed"
apt-get clean || true

echo "=== Branding done ==="
