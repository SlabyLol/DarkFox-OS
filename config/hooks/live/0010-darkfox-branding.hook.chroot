#!/bin/sh
set -e

echo "DarkFox OS Branding..."

echo "darkfox" > /etc/hostname

# Dark theme defaults for every new user (the live user is created from /etc/skel)
mkdir -p /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml

cat > /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml << 'XML'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="ThemeName" type="string" value="Arc-Dark"/>
    <property name="IconThemeName" type="string" value="Papirus-Dark"/>
  </property>
  <property name="Gtk" type="empty">
    <property name="FontName" type="string" value="Noto Sans 10"/>
  </property>
</channel>
XML

cat > /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml << 'XML'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="theme" type="string" value="Arc-Dark"/>
  </property>
</channel>
XML

# sudo for the live user
echo "%sudo ALL=(ALL:ALL) ALL" > /etc/sudoers.d/sudo
chmod 440 /etc/sudoers.d/sudo

# set the live user password at boot (user is created by live-config)
systemctl enable darkfox-password.service 2>/dev/null || \
    ln -sf /etc/systemd/system/darkfox-password.service \
        /etc/systemd/system/multi-user.target.wants/darkfox-password.service

echo "Branding done."
